<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name		"open.files-next">
<!ENTITY plugin		"open.files">
<!ENTITY author		"dlandon">
<!ENTITY version	"2026.11.03">
<!ENTITY launch		"Tools/OpenFiles">
<!ENTITY gitURL		"https://raw.githubusercontent.com/&author;/&name;/master">
<!ENTITY tgzURL		"https://raw.githubusercontent.com/&author;/&name;/v&version;">
<!ENTITY pluginURL	"&gitURL;/&name;.plg">
<!ENTITY supportURL	"https://github.com/dlandon/&name;/discussions">
<!ENTITY MD5		"6627446c069ba25dbb21ff7bcdd1e078">
]>

<PLUGIN	name="&plugin;"
		author="&author;"
		version="&version;"
		launch="&launch;"
		pluginURL="&pluginURL;"
		support="&supportURL;"
		icon="folder-open"
		min="6.11.0">

<CHANGES>
##&name;
###&version;
- Fix: Validate the plugin bundle before changing installed files.
- Fix: Report bundle extraction failures and abort installation.
- Fix: Improve old bundle cleanup to preserve the exact current installation bundle.

###2026.03.22
- Fix: Align plugin name with other Next plugins.

###2026.02.09
- Fix: Notes listing format.

###2026.01.13
- Fix: Update check for open files next.

###2025.12.27
- Fix: URL reference so the plugin will update.

###2025.12.05
- First release as Open Files - Next.
</CHANGES>

<!--
Copyright 2015-2026, Dan Landon
The Open Files plugin shows files that are open that could
prevent a clean shutdown of the array and lets you kill those
tasks.
-->

<!--
Get the plugin bundle.
-->
<FILE Name="/boot/config/plugins/&plugin;/&name;-&version;.tgz">
<URL>"&gitURL;/&name;-&version;.tgz"</URL>
<MD5>&MD5;</MD5>
</FILE>

<!--
The 'pre-install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
# The previous open files plugin cannot be installed.
if [ -f /boot/config/plugins/&plugin;.plg ] ; then
echo ""
echo "-----------------------------------------------------------"
echo " &name; has not been installed!"
echo ""
echo " The previous Open Files plugin is installed."
echo ""
echo " You must uninstall the Open Files plugin"
echo " before installing Open Files - Next."
echo ""
echo "-----------------------------------------------------------"
echo ""
exit 1
fi

#
# Validate the bundle before changing the installed plugin.
#
if ! tar -tf "/boot/config/plugins/&plugin;/&name;-&version;.tgz" >/dev/null 2>&amp;1; then
	echo "ERROR: &name; bundle is missing or invalid. Installation aborted."
	exit 1
fi

#
# Remove emhttp files so we can re-install.
#
rm -f -r /usr/local/emhttp/plugins/&plugin;/* 2>/dev/null

#
# Remove old 'bundle' files.
#
for bundle in /boot/config/plugins/&plugin;/&name;*.tgz; do
	if [[ -f "$bundle" &amp;&amp; "$bundle" != "/boot/config/plugins/&plugin;/&name;-&version;.tgz" ]]; then
		rm -f -- "$bundle"
	fi
done
</INLINE>
</FILE>

<!--
Install the plugin bundle.
-->
<FILE Run="/bin/bash">
<INLINE>
#
# Install the 'bundle'.
#
if ! tar -xf "/boot/config/plugins/&plugin;/&name;-&version;.tgz" -C /usr/local/emhttp/plugins; then
	echo "ERROR: Unable to extract &name; bundle. Installation aborted."
	exit 1
fi
</INLINE>
</FILE>

<!--
The 'post-install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "-----------------------------------------------------------"
echo " &name; is installed."
echo " Copyright 2015-2026, &author;"
echo " Version: &version;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
#
# Remove all plugin files.
#
rm -f -r /usr/local/emhttp/plugins/&plugin; 2>/dev/null
rm -f -r /boot/config/plugins/&plugin; 2>/dev/null

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been removed."
echo " Version: &version;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

</PLUGIN>
